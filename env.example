# Copy to .env.local. Subster has no simulated modes: a service without keys is simply shown as
# not connected, and the features that need it say so.

# --- AI (Google Gemini) ------------------------------------------------------------------------
# aistudio.google.com/apikey (there is a free tier). Powers the agent, classification of unknown
# merchants, live plan checks from official sites, and the AG Studio assistant. Without a key the
# agent runs on the built-in rules engine and prices come from the built-in catalog.
GEMINI_API_KEY=
# Optional model override. Default: gemini-3.8-flash
GEMINI_MODEL=

# --- PayPal -----------------------------------------------------------------------------------
# developer.paypal.com > Apps & Credentials. Enable "Transaction search" on the app.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox
# Id of the webhook registered for <PUBLIC_URL>/api/paypal/webhook. Webhooks are rejected without it.
PAYPAL_WEBHOOK_ID=

# --- Bank link: Plaid (US, Canada, UK, Europe) ------------------------------------------------
# dashboard.plaid.com > Developers > Keys. Sandbox keys link Plaid's test bank; your own bank
# account needs production access from Plaid.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (default) or production
PLAID_ENV=sandbox

# --- Bank link: Account Aggregator through Setu (India) ---------------------------------------
# bridge.setu.co > Account Aggregator Data product. Sandbox works with Setu's test banks.
# Production access is only granted to RBI, SEBI, IRDAI or PFRDA regulated entities.
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
# Default: https://fiu-sandbox.setu.co   Production: https://fiu.setu.co
SETU_BASE_URL=

# --- Spotify sign-in (optional) ---------------------------------------------------------------
# developer.spotify.com > Dashboard. Redirect URI: <PUBLIC_URL>/api/accounts/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Public URL -------------------------------------------------------------------------------
# Where PayPal, Plaid, Setu and Spotify can reach this app (a tunnel or your deployment).
# Needed for webhooks and for redirects back from those services.
PUBLIC_URL=

# --- AG Studio --------------------------------------------------------------------------------
# Optional trial licence key; removes the watermark.
AG_STUDIO_LICENSE=
